---
import { getSupabase } from '../../lib/supabase'

// Solo se muestra el link a quien sea admin — la protección real ya vive en /admin (redirige a
// quien no tenga `is_admin`), esto es solo para no confundir a un usuario común con un link que
// lo manda de vuelta al Dashboard apenas lo toca.
// No hace falta `auth.getUser()` acá: la política RLS de `profiles` ("Usuario ve su propio
// perfil", `using (auth.uid() = id)`) ya filtra la consulta a la fila del dueño del token —
// con un token vencido o ausente, `getSupabase('')` simplemente no devuelve fila y queda en
// `false`, sin necesidad de otra verificación completa de auth acá (ya la hace la página).
const token = Astro.cookies.get('sb-access-token')?.value ?? ''
let esAdmin = false
if (token) {
  const { data: miPerfil } = await getSupabase(token).from('profiles').select('is_admin').maybeSingle()
  esAdmin = !!miPerfil?.is_admin
}

const nav = [
  { href: '/dashboard',   label: 'Dashboard',    icon: '⊞' },
  { href: '/expedientes', label: 'Expedientes',  icon: '📁' },
  { href: '/comitentes',  label: 'Comitentes',   icon: '👥' },
  { href: '/perfil',      label: 'Perfil',       icon: '👤' },
  ...(esAdmin ? [{ href: '/admin', label: 'Administración', icon: '🛠️' }] : []),
]
const current = Astro.url.pathname
---
<aside class="sidebar">
  <a href="/" class="sidebar-logo" style="text-decoration:none;cursor:pointer">
    <img src="/images/logo-nica-circular-blanco.png" alt="NICA" class="logo-badge" />
    <div class="logo-textwrap">
      <span class="logo-text">NICA</span>
      <span class="logo-subtitle">Estudio de Agrimensura</span>
    </div>
  </a>

  <nav class="sidebar-nav">
    {nav.map(item => (
      <a
        href={item.href}
        class={`nav-item ${current.startsWith(item.href) ? 'active' : ''}`}
      >
        <span class="nav-icon">{item.icon}</span>
        <span>{item.label}</span>
      </a>
    ))}
  </nav>

  <div class="sidebar-footer">
    <form method="POST" action="/api/auth/logout">
      <button type="submit" class="logout-btn">Cerrar sesión</button>
    </form>
  </div>
</aside>

<style>
.sidebar {
  width: 220px;
  min-height: 100vh;
  background: var(--color-primary-dark);
  display: flex;
  flex-direction: column;
  padding: 1.5rem 0;
  flex-shrink: 0;
}
.sidebar-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 1.25rem 1.75rem;
  border-bottom: 1px solid rgba(255,255,255,0.08);
  margin-bottom: 1rem;
}
.logo-badge {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  object-fit: contain;
  /* El logo nuevo es blanco sin fondo, pensado para apoyarse directo sobre el sidebar oscuro —
     el fondo blanco de antes (para el ícono viejo, que sí necesitaba contraste) lo taparía. */
  flex-shrink: 0;
}
.logo-textwrap {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
  min-width: 0;
}
.logo-text {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--color-text-inverse);
  letter-spacing: 0.05em;
}
.logo-subtitle {
  font-size: 0.6rem;
  font-weight: 500;
  color: rgba(255,255,255,0.5);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 0 0.75rem;
}
.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0.625rem 0.75rem;
  border-radius: var(--radius-sm);
  color: rgba(255,255,255,0.65);
  font-size: 0.9rem;
  font-weight: 500;
  text-decoration: none;
  transition: background 0.15s, color 0.15s;
}
.nav-item:hover { background: rgba(255,255,255,0.07); color: #fff; text-decoration: none; }
.nav-item.active { background: rgba(255,255,255,0.12); color: #fff; }
.nav-icon { font-size: 1rem; }
.sidebar-footer {
  padding: 1rem 1.25rem 0;
  border-top: 1px solid rgba(255,255,255,0.08);
  /* Margen notoriamente más grande que el gap de 2px entre los ítems del nav de arriba,
     para que quede claramente separado del resto en vez de pegado a "Perfil". */
  margin-top: 2rem;
}
.logout-btn {
  background: #dc2626;
  border: 1px solid #dc2626;
  color: #fff;
  padding: 0.4rem 0.875rem;
  border-radius: var(--radius-sm);
  font-size: 0.8125rem;
  font-weight: 500;
  cursor: pointer;
  width: 100%;
  transition: background 0.15s, border-color 0.15s;
}
.logout-btn:hover { background: #b91c1c; border-color: #b91c1c; }
</style>
